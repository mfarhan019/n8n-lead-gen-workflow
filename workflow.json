        "message": "=<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n</head>\n<body style=\"margin:0; padding:0; background-color:#f4f6f8; font-family: 'Segoe UI', Arial, sans-serif;\">\n\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding: 30px 0;\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"500\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff; border-radius:12px; overflow:hidden; box-shadow:0 4px 20px rgba(0,0,0,0.08);\">\n\n          <!-- Header -->\n          <tr>\n            <td style=\"background: linear-gradient(135deg, #4f46e5, #6366f1); padding: 28px 30px;\">\n              <h1 style=\"color:#ffffff; margin:0; font-size:22px;\">📩 New Lead Alert</h1>\n              <p style=\"color:#e0e7ff; margin:6px 0 0; font-size:14px;\">A new lead just came through your form</p>\n            </td>\n          </tr>\n\n          <!-- Status Badge -->\n          <tr>\n            <td style=\"padding: 20px 30px 0;\">\n              <span style=\"display:inline-block; padding: 6px 16px; border-radius: 20px; font-size: 13px; font-weight: 600; color:#ffffff; background-color: {{$json.status === 'Genuine Lead' ? '#22c55e' : '#ef4444'}};\">\n                {{ $('Checks if the incoming lead is genuine or fake').item.json.status }}\n              </span>\n            </td>\n          </tr>\n\n          <!-- Lead Details -->\n          <tr>\n            <td style=\"padding: 24px 30px;\">\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                <tr>\n                  <td style=\"padding: 10px 0; border-bottom: 1px solid #eee;\">\n                    <span style=\"color:#6b7280; font-size:13px;\">Name</span><br>\n                    <span style=\"color:#111827; font-size:16px; font-weight:600;\">{{ $('Checks if the incoming lead is genuine or fake').item.json.name }}</span>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding: 10px 0; border-bottom: 1px solid #eee;\">\n                    <span style=\"color:#6b7280; font-size:13px;\">Email</span><br>\n                    <span style=\"color:#111827; font-size:16px;\">{{ $('Checks if the incoming lead is genuine or fake').item.json.email }}</span>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding: 10px 0; border-bottom: 1px solid #eee;\">\n                    <span style=\"color:#6b7280; font-size:13px;\">Phone</span><br>\n                    <span style=\"color:#111827; font-size:16px;\">{{ $('Checks if the incoming lead is genuine or fake').item.json.phone }}</span>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding: 10px 0; border-bottom: 1px solid #eee;\">\n                    <span style=\"color:#6b7280; font-size:13px;\">Treatment Type</span><br>\n                    <span style=\"color:#111827; font-size:16px;\">{{ $('Checks if the incoming lead is genuine or fake').item.json.treatmentType }}</span>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding: 10px 0;\">\n                    <span style=\"color:#6b7280; font-size:13px;\">Date Received</span><br>\n                    <span style=\"color:#111827; font-size:16px;\">{{ $('Checks if the incoming lead is genuine or fake').item.json.date }}</span>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td style=\"background:#f9fafb; padding: 18px 30px; text-align:center;\">\n              <p style=\"margin:0; color:#9ca3af; font-size:12px;\">This is an automated notification from your lead generation system.</p>\n            </td>\n          </tr>\n\n        </table>\n      </td>\n    </tr>\n  </table>\n\n</body>\n</html>",
